<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="root" prefWidth="800.0" prefHeight="600.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.farmingdale.advancedprogramming_capstone_project.ProfileController"
            stylesheets="@profile.css">

    <children>
        <VBox alignment="TOP_CENTER" spacing="24.0"
              AnchorPane.topAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- Title -->
            <Label text="My Profile" styleClass="title"/>

            <!-- Avatar -->
            <StackPane>
                <!-- Circular placeholder that will clip a selected image -->
                <Circle fx:id="avatarCircle" radius="60.0" styleClass="avatar"/>
                <Button fx:id="changeAvatarBtn" text="Change" styleClass="secondary-button"/>
            </StackPane>

            <!-- Form -->
            <GridPane alignment="CENTER" hgap="22.0" vgap="18.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120.0"/>
                    <ColumnConstraints halignment="LEFT"/>
                </columnConstraints>

                <!-- First name -->
                <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="firstNameField" promptText="First name"
                           styleClass="custom-textfield"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Last name -->
                <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="lastNameField" promptText="Last name"
                           styleClass="custom-textfield"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Email row -->
                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <TextField fx:id="emailField" promptText="you@example.com" editable="true"
                               styleClass="custom-textfield"/>
                    <Button fx:id="changeEmailBtn" text="Change" styleClass="secondary-button"/>
                </HBox>

                <!-- Password row -->
                <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <PasswordField fx:id="passwordField" promptText="••••••••" editable="true"
                                   styleClass="custom-textfield"/>
                    <Button fx:id="changePasswordBtn" text="Change" styleClass="secondary-button"/>
                </HBox>

                <!-- Bio -->
                <Label text="Bio:" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <TextArea fx:id="bioArea" promptText="Tell us about yourself…" wrapText="true" prefRowCount="4"
                          styleClass="custom-textarea"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Save button -->
            <Button fx:id="saveBtn" text="Save Changes" styleClass="primary-button"/>
        </VBox>
    </children>
</AnchorPane>