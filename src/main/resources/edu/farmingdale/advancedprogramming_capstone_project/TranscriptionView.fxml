<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.advancedprogramming_capstone_project.TranscriptionController" alignment="CENTER">
    <VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="5.0" style="-fx-padding: 10;">
        <Button fx:id="stopBtn" alignment="CENTER" mnemonicParsing="false" onAction="#stopTranscription" text="Stop Transcription" translateX="20.0" translateY="5.0">
            <VBox.margin>
                <Insets right="200.0" />
            </VBox.margin>
        </Button>
        <Button fx:id="startBtn" alignment="CENTER" mnemonicParsing="false" onAction="#startTranscribing" text="Start Transcription" translateX="-20.0" translateY="-26.0">
            <VBox.margin>
                <Insets left="200.0" />
            </VBox.margin>
        </Button>
        <TextArea fx:id="transcriptionTextArea" editable="false" prefHeight="280.0" prefWidth="380" wrapText="true" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="-15.0" />
            </VBox.margin>
        </TextArea>
        <Label fx:id="statusLb" alignment="CENTER" text="Ready To Transcribe">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>
        <HBox.margin>
            <Insets />
        </HBox.margin>
    </VBox>
</HBox>