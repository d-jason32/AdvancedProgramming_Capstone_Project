<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.advancedprogramming_capstone_project.MainController">
    <top>
        <Label styleClass="title-label" text="AI Whiteboard Teaching Tool" BorderPane.alignment="CENTER" />
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox spacing="10">
                <Button onAction="#startNewCall" text="Start New Call" />
                <Label fx:id="sessionLabel" styleClass="info-label" />
                <Button text="My Profile" onAction="#goToProfile" />
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="joinSessionField" promptText="Enter session code to join" />
                <Button onAction="#joinCall" text="Join Call" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#getSummary" text="Get Summary" />
                <Label fx:id="summaryLabel" styleClass="info-label" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#openTranscriptionWindow" text="Live Transcription" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <Label styleClass="footer-label" text="Use the controls above to manage sessions, video chat, transcription, and summaries." BorderPane.alignment="CENTER" />
    </bottom>
</BorderPane>
