<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane fx:id="borderPane" prefHeight="795.0" prefWidth="915.0" stylesheets="@styling/database_styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.advancedprogramming_capstone_project.DatabaseController">
   <center>
      <StackPane fx:id="box1" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="900.0" BorderPane.alignment="CENTER">
         <children>
                <VBox prefHeight="264.0" prefWidth="116.0" styleClass="left_pane">
               <children>
                      <TableView fx:id="tv" onMouseClicked="#selectedItemTV" prefHeight="195.0" prefWidth="668.0">
                          <columns>
                              <TableColumn fx:id="tv_id" prefWidth="160.0" text="ID" />
                              <TableColumn fx:id="tv_fn" prefWidth="175.0" text="First Name" />
                              <TableColumn fx:id="tv_ln" prefWidth="175.0" text="Last Name" />
                              <TableColumn fx:id="tv_email" prefWidth="175.0" text="Email" />
                              <TableColumn fx:id="tv_password" prefWidth="175.0" text="Password" />
                          </columns>
                      </TableView>
                  <HBox prefHeight="468.0" prefWidth="860.0">
                     <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                  <children>
                                      <Button alignment="CENTER" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#connectButton" prefWidth="250.0" styleClass="nav_btn" text="Connect">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                      <Button fx:id="addBtn" mnemonicParsing="false" onAction="#displayButton" styleClass="nav_btn" text="Display All">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                      <Button mnemonicParsing="false" onAction="#insertButton" styleClass="nav_btn" text="Insert">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                      <Button mnemonicParsing="false" onAction="#queryButton" styleClass="nav_btn" text="Query ID">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                      <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteByID" styleClass="nav_btn" text="Delete ID">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                      <Button mnemonicParsing="false" onAction="#editButton" styleClass="nav_btn" text="Edit ID">
                                          <VBox.margin>
                                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </Button>
                                  </children>
                              </VBox>
                        <VBox alignment="CENTER" prefHeight="467.0" prefWidth="295.0">
                           <children>
                                      <TextField fx:id="id" maxWidth="-Infinity" prefHeight="26.0" prefWidth="200.0" promptText="ID">
                                          <VBox.margin>
                                              <Insets bottom="10.0" />
                                          </VBox.margin>
                                      </TextField>
                                      <TextField fx:id="first_name" maxWidth="-Infinity" prefHeight="26.0" prefWidth="200.0" promptText="First Name">
                                          <VBox.margin>
                                              <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                                          </VBox.margin>
                                      </TextField>
                                      <TextField fx:id="last_name" maxWidth="-Infinity" prefHeight="28.0" prefWidth="200.0" promptText="Last Name">
                                          <VBox.margin>
                                              <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                                          </VBox.margin>
                                      </TextField>
                                      <TextField fx:id="email" maxWidth="-Infinity" prefWidth="200.0" promptText="Email">
                                          <VBox.margin>
                                              <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                                          </VBox.margin>
                                      </TextField>
                                      <TextField fx:id="password" maxWidth="-Infinity" prefWidth="200.0" promptText="Password">
                                          <VBox.margin>
                                              <Insets bottom="15.0" left="10.0" right="10.0" top="5.0" />
                                          </VBox.margin>
                                      </TextField>
                           </children>
                        </VBox>
                              <VBox alignment="CENTER" prefHeight="467.0" prefWidth="430.0" stylesheets="@styling/database_styles.css">
                                  <children>
                                      <TextArea fx:id="feedback" prefHeight="200.0" prefWidth="200.0">
                                          <VBox.margin>
                                              <Insets left="10.0" right="10.0" top="10.0" />
                                          </VBox.margin>
                                      </TextArea>
                                  </children>
                              </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
